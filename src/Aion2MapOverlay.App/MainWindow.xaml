<Window x:Class="Aion2MapOverlay.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Aion 2 Map Overlay" Width="760" Height="1020" MinWidth="680" MinHeight="780"
 Background="#10151E" Foreground="#E7EDF5" FontFamily="Segoe UI" FontSize="13">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="Background" Value="#263447"/><Setter Property="Foreground" Value="#E7EDF5"/>
   <Setter Property="BorderBrush" Value="#36465B"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#354860"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.7"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.35"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#18212E"/><Setter Property="BorderBrush" Value="#283548"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="16"/></Style>
  <Style TargetType="Slider"><Setter Property="Margin" Value="0,8,0,0"/></Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#E7EDF5"/><Setter Property="Background" Value="#101923"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <ToggleButton IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#101923" BorderBrush="#36465B" BorderThickness="1" CornerRadius="6" Padding="10"><TextBlock Text="⌄" HorizontalAlignment="Right" Foreground="#9BAFC6"/></Border></ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="10,8,30,8" IsHitTestVisible="False"/>
     <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
      <Border Background="#18212E" BorderBrush="#36465B" BorderThickness="1" CornerRadius="6" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="4"><ScrollViewer MaxHeight="240"><ItemsPresenter/></ScrollViewer></Border>
     </Popup>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#E7EDF5"/><Setter Property="Padding" Value="8"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#101923"/><Setter Property="Foreground" Value="#E7EDF5"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#36465B"/><Setter Property="Padding" Value="10,8"/></Style>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,18">
   <StackPanel><TextBlock Text="Aion 2 Map Overlay" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="VERTERON  /  SCREEN CAPTURE ONLY" FontSize="11" Foreground="#87A1BD" Margin="0,6,0,0"/></StackPanel>
   <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="6" Background="#203548" Padding="10,7"><TextBlock x:Name="ResourceUsageText" Text="CPU — · RAM —" FontSize="11" Foreground="#9BD9EE" ToolTip="This app only. CPU is averaged over one second across total logical CPU capacity. RAM is working set."/></Border>
  </Grid>
  <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
   <StackPanel>
    <TextBlock Text="Display containing the game" Foreground="#9BAFC6" Margin="0,0,0,7"/>
    <ComboBox x:Name="DisplayPicker" Padding="7" Margin="0,0,0,12"/>
    <WrapPanel>
     <Button x:Name="StartButton" Content="Start overlay" Background="#23637B" BorderBrush="#3289A2" Click="Start_Click"/>
     <Button x:Name="StopButton" Content="Stop" IsEnabled="False" Click="Stop_Click"/>
     <Button Content="Test screenshot…" Click="Screenshot_Click"/>
     <Button x:Name="ScreenshotModeButton" Content="Screenshot mode (F8)" Click="ScreenshotMode_Click" ToolTip="Freeze for Win+Shift+S. This button gives you 3 seconds to return to the game."/>
    </WrapPanel>
    <TextBlock x:Name="ScreenshotModeText" Text="F8 → Win+Shift+S → F8 to resume" Foreground="#87A1BD" FontSize="11" Margin="0,10,0,0"/>
    <TextBlock x:Name="StatusText" Text="Ready. Choose resources and start the overlay." TextWrapping="Wrap" Foreground="#B6C9DD" Margin="0,8,0,0"/>
    <Border x:Name="SetupPanel" Visibility="Collapsed" Background="#203548" CornerRadius="7" Padding="10" Margin="0,10,0,0">
     <StackPanel>
      <TextBlock x:Name="SetupText" TextWrapping="Wrap" Text="Download markers, map artwork, and icons directly from Questlog for local use."/>
      <Button x:Name="SetupButton" Content="Download map data" Click="Setup_Click" Margin="0,8,0,0"/>
     </StackPanel>
    </Border>
   </StackPanel>
  </Border>
  <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,18">
   <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Icon size"/><Slider x:Name="IconSize" Minimum="10" Maximum="36" Value="20" TickFrequency="2" ValueChanged="Appearance_Changed"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="Opacity"/><Slider x:Name="IconOpacity" Minimum="0.25" Maximum="1" Value="0.9" ValueChanged="Appearance_Changed"/></StackPanel>
    <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,16,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center">
      <CheckBox x:Name="NavigationToggle" Content="Nearest resource direction" Foreground="#E7EDF5" Checked="Navigation_Changed" Unchecked="Navigation_Changed"/>
      <CheckBox x:Name="MinimapIconsToggle" Content="Resource icons on minimap" IsChecked="True" Foreground="#E7EDF5" Margin="0,8,0,0" Checked="Navigation_Changed" Unchecked="Navigation_Changed"/>
      <TextBlock Text="North-up direction on the selected minimap · mapped spawns only" FontSize="11" Foreground="#87A1BD" Margin="20,5,0,0"/>
     </StackPanel>
     <StackPanel Grid.Column="1">
     <ComboBox x:Name="MinimapPresetPicker" SelectedIndex="1" SelectionChanged="MinimapPreset_Changed" ToolTip="Choose the minimap layout used in Aion 2">
      <ComboBoxItem Content="Default minimap"/><ComboBoxItem Content="Larger minimap"/>
     </ComboBox>
     <Button Content="Larger minimap setup…" Click="HudGuide_Click" Margin="0,7,0,0" Padding="8,5" FontSize="11"/>
     <Button Content="Select minimap area…" Click="SelectMinimap_Click" Margin="0,7,0,0" Padding="8,6" FontSize="11" Background="#20516C" BorderBrush="#3289A2"/>
     <Button Content="Reset to preset" Click="ResetMinimap_Click" Margin="0,7,0,0" Padding="8,5" FontSize="11"/>
     </StackPanel>
     <TextBlock x:Name="MinimapRegionText" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0" Foreground="#84CBE5" TextWrapping="Wrap" FontSize="11" Text="Using preset area"/>
    </Grid>
   </Grid>
  </Border>
  <StackPanel Grid.Row="3">
   <Grid Margin="0,0,0,10"><TextBlock Text="Resources &amp; collectibles" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="SelectionText" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#87A1BD"/></Grid>
   <Grid Margin="0,0,0,10">
    <TextBox x:Name="SearchBox" TextChanged="Search_Changed" ToolTip="Search resources and collectibles"/>
    <TextBlock Text="Search resources and collectibles…" Foreground="#728AA5" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
   </Grid>
   <WrapPanel Margin="0,0,0,10"><Button Content="All" Click="All_Click"/><Button Content="None" Click="None_Click"/><Button Content="Gatherables" Click="Gatherables_Click"/><Button Content="Collectibles" Click="Collectibles_Click"/></WrapPanel>
  </StackPanel>
  <ListBox x:Name="GroupsList" Grid.Row="4" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SizeChanged="GroupsList_SizeChanged">
   <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid x:Name="ResourceGrid" Columns="3"/></ItemsPanelTemplate></ListBox.ItemsPanel>
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate><DataTemplate>
    <ToggleButton IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="0,0,10,10" Foreground="#E7EDF5" Cursor="Hand" HorizontalContentAlignment="Stretch" ToolTip="{Binding Name}">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
      <Border x:Name="Tile" CornerRadius="10" Background="#18212E" BorderBrush="#2B394D" BorderThickness="2" Padding="12">
       <Grid><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="40"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Image Source="{Binding Icon}" Width="30" Height="30" HorizontalAlignment="Left"/>
        <TextBlock x:Name="Check" Text="✓" HorizontalAlignment="Right" Foreground="#77D8EF" Visibility="Collapsed" FontSize="18"/>
        <TextBlock Grid.Row="1" Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="2" Foreground="#8DA5BF" FontSize="11"><Run Text="{Binding TypeLabel, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Count, Mode=OneWay}"/></TextBlock>
       </Grid>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="#223145"/></Trigger>
       <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="#53BCD7"/><Setter TargetName="Tile" Property="Background" Value="#1B3545"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="#D8F6FF"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate></ToggleButton.Template>
    </ToggleButton>
   </DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <StackPanel Grid.Row="5" Margin="0,10,0,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center"><TextBlock x:Name="UpdateText" Foreground="#9BAFC6" FontSize="11" TextWrapping="Wrap"/><CheckBox x:Name="AutomaticUpdateToggle" Content="Check for updates on startup" IsChecked="True" Foreground="#87A1BD" FontSize="11" Margin="0,5,0,0" Checked="UpdatePreference_Changed" Unchecked="UpdatePreference_Changed"/></StackPanel>
    <Button x:Name="UpdateButton" Grid.Column="1" Content="Check for updates" Click="Update_Click" Margin="12,0,0,0"/>
   </Grid>
   <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="#7D94AE" TextWrapping="Wrap" Text="Possible spawn locations · availability is not tracked. Data: Questlog.gg / NCSOFT. Settings save beside the executable."/>
  </StackPanel>
 </Grid>
</Window>
